{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/glacier"
			],
			"outFiles": [
				"${workspaceFolder}/glacier/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			"name": "Run Web Extension",
			"type": "extensionHost",
			"debugWebWorkerHost": true,
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/glacier",
				"--extensionDevelopmentKind=web"
			],
			"outFiles": [
				"${workspaceFolder}/glacier/dist/web/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		}
	]
}
