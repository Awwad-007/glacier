{
  "name": "glacier",
  "displayName": "glacier",
  "description": "An AI coding agent for VS Code, powered by the TrueForge agent harness. Describe a change in plain English, review it hunk by hunk, and accept or undo.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onView:glacier.chatView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "glacier-sidebar",
          "title": "Glacier",
          "icon": "resources/glacier.svg"
        }
      ]
    },
    "views": {
      "glacier-sidebar": [
        {
          "type": "webview",
          "id": "glacier.chatView",
          "name": "Glacier Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "glacier.openChat",
        "title": "Glacier: Open Chat"
      },
      {
        "command": "glacier.newSession",
        "title": "Glacier: New Chat Session",
        "icon": "$(plus)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "glacier.newSession",
          "when": "view == glacier.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Glacier",
      "properties": {
        "glacier.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge server base URL."
        },
        "glacier.model": {
          "type": "string",
          "default": "google-gemini/gemini-3-8-flash",
          "description": "Model to use for TrueForge agent sessions."
        },
        "glacier.agentName": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional named agent in the TrueForge agent registry."
        },
        "glacier.idleTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Idle timeout in milliseconds before an unresponsive turn stream is aborted."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:client": "node --test tests/client.test.cjs tests/eventStream.test.cjs tests/idleTimeout.test.cjs tests/provider.test.cjs",
    "test": "npm run test:client"
  },
  "devDependencies": {
    "@types/vscode": "^1.145.0",
    "@types/mocha": "^10.0.10",
    "@types/assert": "^1.5.11",
    "eslint": "^10.5.0",
    "typescript-eslint": "^8.61.1",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "npm-run-all": "^4.1.5",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "assert": "^2.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
